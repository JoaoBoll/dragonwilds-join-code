#!/bin/sh
set -eu

# This file is installed as root and accepts no parameters. The web service can
# therefore read only the last JoinCode from this one named container.
if [ "$#" -ne 0 ]; then
  exit 2
fi

/usr/bin/docker logs --tail 1000 dragonwilds-local 2>&1 \
  | /usr/bin/sed -nE 's/.*Setting \["JoinCode"\].*value\[([A-Z0-9]{4,12}-[A-Z0-9]{4,12})\].*/\1/p' \
  | /usr/bin/tail -n 1
